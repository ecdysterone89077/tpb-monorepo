# ===== TPB API (apps/api) — copy to .env for local development =====
# Production should inject these values through PM2/container secrets.

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
DATABASE_URL="mysql://tpb:tpb-dev-password@localhost:3306/tpb"

# Generate a strong value with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-at-least-64-random-hex-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Refresh cookie. Production: COOKIE_SECURE=true and COOKIE_DOMAIN=.unupurwokerto.ac.id when appropriate.
COOKIE_SECURE=false
COOKIE_NAME=tpb_refresh
COOKIE_DOMAIN=

# Relative paths are for local development. Production must use a persistent absolute path.
MEDIA_DIR=uploads
MEDIA_MAX_MB=10

# Set true only when the API is directly behind a trusted reverse proxy.
# A non-negative integer is also accepted to trust that many proxy hops.
TRUST_PROXY=false
