# ===== TPB API (apps/api) — copy to .env and fill =====

# Application
NODE_ENV=development
PORT=3000
# Comma-separated allowlist, no trailing slash. NEVER "*" in production.
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# MySQL 8.0 (local dev docker-compose)
DATABASE_URL="mysql://tpb:tpb-dev-password@localhost:3306/tpb"

# Auth — generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-different-64-hex-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Refresh cookie. In production: true, tpb_refresh, .unupurwokerto.ac.id
COOKIE_SECURE=false
COOKIE_NAME=tpb_refresh
COOKIE_DOMAIN=

# Bootstrap admin (only usable while the users table is empty)
BOOTSTRAP_NAME=Admin TPB
BOOTSTRAP_EMAIL=admin@tpb.local

# Media upload directory (relative to apps/api)
MEDIA_DIR=uploads
MEDIA_MAX_MB=10
